# Copy to .env and replace with your own OpenRouter API key.
OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_MODEL=openai/gpt-4.1-mini

# MySQL 8.4 is the primary relational database in Docker Compose.
MYSQL_DATABASE=diabetes_agent
MYSQL_USER=diabetes
MYSQL_PASSWORD=change-this-app-password
MYSQL_ROOT_PASSWORD=change-this-root-password
DATABASE_URL=mysql+pymysql://diabetes:change-this-app-password@mysql:3306/diabetes_agent?charset=utf8mb4

# Neo4j stores the knowledge graph and document embeddings.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-neo4j-password
NEO4J_DATABASE=neo4j
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TRAINING_DATA_SOURCE=database

# Runtime controls for dynamic orchestration.
AGENT_MAX_STEPS=12
AGENT_TOOL_TIMEOUT_SECONDS=30
ALLOW_SQLITE_FALLBACK=false
